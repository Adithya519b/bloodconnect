# Copy this file to .env and fill in the real values.
# .env is ignored by Git, .env.example is committed so others know what is needed.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# MongoDB Atlas connection string
MONGODB_URI=

# Express server port
PORT=5000

# Shared key for the admin dashboard API (prototype-only protection).
# Leave empty for local development; set any random string for the demo.
ADMIN_API_KEY=

NODE_ENV=development
